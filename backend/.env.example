PORT=3000
CRIC_API_KEY=replace-with-current-cric-api-key
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
# GPT-OSS models: low is faster; medium/high spend more time reasoning.
GROQ_REASONING_EFFORT=low
GOOGLE_CLOUD_PROJECT=cricket-prediction-app-a0f1c
# Use the full service account JSON as a single-line environment value on Voroa.
# Keep it out of the mobile app and Git.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or use GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json locally.
# Enable only when you intend to run Firestore writes and CricAPI fetches.
SCHEDULER_ENABLED=false
# false = log notifications instead of sending them (use locally; Firebase is shared with production).
NOTIFICATIONS_ENABLED=false
# Optional: override the daily CricAPI limit (default: hitsLimit reported by CricAPI).
# CRICAPI_DAILY_LIMIT=2000
# Optional: max notifications per topic per IST day (default 6).
# NOTIF_DAILY_CAP_PER_TOPIC=6
# Optional: AdMob publisher ID served in /app-ads.txt.
# ADMOB_PUBLISHER_ID=pub-1800123243044416
# Key handed to old app versions (which call CricAPI directly) via /config/cric-api.
# Use a separate free key, never CRIC_API_KEY; leave unset to turn the endpoint off.
# LEGACY_CRIC_API_KEY=
